{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(mise ls *)",
      "Bash(mise which *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm format *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(golangci-lint *)",
      "Bash(pre-commit run *)",
      "Bash(gitleaks *)",
      "Bash(actionlint *)",
      "Bash(hadolint *)",
      "Bash(kustomize build *)",
      "Bash(kubeconform *)",
      "Bash(kube-linter *)",
      "Bash(trivy fs *)",
      "Bash(trivy config *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm approve-builds *)",
      "Bash(pnpm dlx *)",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(mise use *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/homelab/**)",
      "Edit(~/homelab/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.vault_pass)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.terraform.d/**)",
      "Read(~/.minikube/**)",
      "Read(~/.ansible/**)",
      "Edit(~/.config/**)",
      "Edit(~/.local/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.docker/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.cargo/**)",
      "Edit(~/bin/**)",
      "Edit(~/go/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_login)",
      "Edit(~/.bash_logout)",
      "Edit(~/.bash_aliases)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zlogin)",
      "Edit(~/.gitconfig)",
      "Edit(~/.npmrc)",
      "Edit(~/.tmux.conf)",
      "Edit(~/.inputrc)",
      "Edit(~/.vimrc)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/mise.toml)",
      "Edit(~/.mise.toml)",
      "Edit(~/.tool-versions)",
      "Edit(~/apps/*.toml)",
      "Edit(~/apps/.*)",
      "Edit(.git/hooks/**)",
      "Edit(.git/config)",
      "Edit(~/.cache/**)",
      "Edit(~/.npm/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/output-styles/**)",
      "Edit(~/.claude/workflows/**)",
      "Edit(~/.claude/routines/**)",
      "Edit(~/.claude/scheduled_tasks.json)",
      "Edit(~/.claude/launch.json)",
      "Edit(~/.claude/loop.md)",
      "Edit(~/*.toml)",
      "Edit(~/.envrc)",
      "Edit(~/.mise/**)",
      "Edit(~/mise/**)",
      "Bash(git push *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(terraform *)",
      "Bash(tofu *)",
      "Bash(ansible *)",
      "Bash(ansible-playbook *)",
      "Bash(packer *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(kind *)",
      "Bash(env)",
      "Bash(printenv *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/homelab",
        "~/.ssh",
        "~/.kube",
        "~/.vault_pass",
        "~/.config/gh",
        "~/.docker"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "PROXMOX_TOKEN", "mode": "deny" },
        { "name": "PROXMOX_VE_API_TOKEN", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "nodejs.org",
        "go.dev",
        "dl.google.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
