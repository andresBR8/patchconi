{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(mise install)",
      "Bash(mise ls *)",
      "Bash(mise which *)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm format *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(golangci-lint *)",
      "Bash(pre-commit run *)",
      "Bash(gitleaks *)",
      "Bash(actionlint *)",
      "Bash(hadolint *)",
      "Bash(kustomize build *)",
      "Bash(kubeconform *)",
      "Bash(kube-linter *)",
      "Bash(trivy fs *)",
      "Bash(trivy config *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm approve-builds *)",
      "Bash(pnpm dlx *)",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(mise use *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/homelab/**)",
      "Edit(~/homelab/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.vault_pass)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Bash(git push *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(terraform *)",
      "Bash(tofu *)",
      "Bash(ansible *)",
      "Bash(ansible-playbook *)",
      "Bash(packer *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(kind *)",
      "Bash(env)",
      "Bash(printenv *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/homelab",
        "~/.ssh",
        "~/.kube",
        "~/.vault_pass",
        "~/.config/gh",
        "~/.docker"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "PROXMOX_TOKEN", "mode": "deny" },
        { "name": "PROXMOX_VE_API_TOKEN", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "nodejs.org",
        "go.dev",
        "dl.google.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
