root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# Captured command output, kept byte for byte: the agent's parser tests read
# it as golden files, and dnf pads some lines with spaces.
[protocol/captures/{containers,hosts}/**]
trim_trailing_whitespace = false
